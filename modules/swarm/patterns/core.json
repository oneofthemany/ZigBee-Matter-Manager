  {
    "id": "door_left_open",
    "title": "Keep reminding while a door is left open",
    "description": "Once a door has been open a while it messages, then again every few minutes until it is shut. Shutting it before the first reminder sends nothing.",
    "category": "security",
    "scope": "house",
    "slots": {
      "door": {
        "role": "trigger",
        "offer": "contact:opened",
        "sustain": {
          "param": "open_hold_s"
        }
      },
      "shut": {
        "role": "condition",
        "offer": "contact:is_closed",
        "prefer": "same_device",
        "prefer_slot": "door"
      },
      "who": {
        "role": "action",
        "offer": "notify:message"
      }
    },
    "emits": {
      "name": "$trigger_device left open",
      "source": "door",
      "conditions": [
        "door"
      ],
      "then": [
        {
          "type": "repeat",
          "mode": "until",
          "max_iterations": {
            "param": "remind_max"
          },
          "inline_conditions": [
            {
              "$cond": "shut"
            }
          ],
          "steps": [
            {
              "type": "request",
              "to_user": "$who",
              "message": "{trigger} is still open ({time})."
            },
            {
              "type": "wait_for",
              "$cond": "shut",
              "timeout": {
                "param": "remind_min",
                "scale": 60
              }
            }
          ]
        }
      ],
      "run_mode": "single",
      "cooldown": 600
    },
    "params": {
      "open_hold_s": 300,
      "remind_min": 10,
      "remind_max": 6
    }
  },
