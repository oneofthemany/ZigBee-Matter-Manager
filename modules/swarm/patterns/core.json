          "switch",
          "plug"
        ]
      }
    },
    "emits": {
      "name": "{room} light off when empty",
      "source": "clear",
      "conditions": [
        "clear"
      ],
      "then": [
        "light"
      ],
      "cooldown": 30
    },
    "params": {
      "clear_hold_s": 300
    }
  },
  {
    "id": "door_entry_light",
    "title": "Light on when the door opens after dark",
    "description": "The entry-hall pattern: coming through the door in the dark should not need a light switch.",
    "category": "lighting",
    "scope": "room",
    "slots": {
      "door": {
        "role": "trigger",
        "offer": "contact:opened"
      },
      "dark": {
        "role": "condition",
        "offer": "illuminance:is_dark",
        "optional": true
      },
      "light": {
        "role": "action",
        "offer": "on_off:turn_on",
        "device_class": [
          "light",
          "color_light",
          "switch"
        ]
      }
    },
    "emits": {
      "name": "{room} light on door open",
      "source": "door",
      "conditions": [
        "door",
        "dark"
      ],
      "condition_logic": "and",
      "then": [
        "light"
      ],
      "cooldown": 5
    },
    "params": {
      "dark_lux": 11
    }
  },
  {
    "id": "dark_light_on",
    "title": "Lights on when the room gets dark",
    "description": "Every light in the room comes on as the room darkens and goes back to how it was when it brightens. Uses a light sensor if the room has one; otherwise the hub estimates the room's daylight from its windows on the floor plan. Untick any light to leave it alone.",
    "category": "lighting",
    "scope": "room",
    "slots": {
      "dark": {
        "role": "trigger",
        "offer": "illuminance:got_dark",
        "sustain": 120
      },
      "lights": {
        "role": "action",
        "offer": "on_off:turn_on",
        "device_class": [
          "light",
          "color_light"
        ],
        "collect": true
      }
    },
    "emits": {
      "name": "{room} lights follow daylight",
      "source": "dark",
      "conditions": [
        "dark"
      ],
      "then": [
        {
          "type": "snapshot",
          "targets": [
            "$lights@all"
          ],
          "name": "before_dark"
        },
        "lights"
      ],
      "else": [
        {
          "type": "restore",
          "name": "before_dark"
        }
      ],
      "cooldown": 300
    },
    "params": {
      "dark_lux": 11
    }
  },
