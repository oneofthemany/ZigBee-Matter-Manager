[
  {
    "id": "presence_light_when_dark",
    "title": "Light on when the room is occupied after dark",
    "description": "Turns the light on when someone is detected and the room is dark, then off again once it has been empty for a while.",
    "category": "lighting",
    "scope": "room",
    "slots": {
      "trig": {
        "role": "trigger",
        "offer": "presence:detected"
      },
      "dark": {
        "role": "condition",
        "offer": "illuminance:is_dark",
        "optional": true,
        "prefer": "same_device",
        "prefer_slot": "trig"
      },
      "light": {
        "role": "action",
        "offer": "on_off:turn_on",
        "device_class": [
          "light",
          "color_light",
          "switch",
          "plug"
        ]
      },
      "off": {
        "role": "action",
        "offer": "on_off:turn_off",
        "optional": true,
        "prefer": "same_device",
        "prefer_slot": "light"
      }
    },
    "emits": {
      "name": "{room} light on presence",
      "source": "trig",
      "conditions": [
        "trig",
        "dark"
      ],
      "condition_logic": "and",
      "then": [
        "light"
      ],
      "else": [
        "off"
      ],
      "cooldown": 5
    },
    "params": {
      "dark_lux": 11,
      "clear_hold_s": 120
    }
  },
  {
    "id": "presence_light_off_when_empty",
    "title": "Light off when the room empties",
    "description": "For rooms where the light is switched on by hand but nobody remembers to switch it off.",
