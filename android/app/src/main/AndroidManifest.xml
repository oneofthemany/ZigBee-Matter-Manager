<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Requested SEPARATELY and only after foreground location is granted:
         Android 11+ refuses to show both in one prompt, and a geofence does not
         survive the app being killed without it. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Re-arm geofences after a reboot; the OS drops them on restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Android 13+: needed only for the "geofence armed / report failed" notices. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Lets the app ask the user to exempt it from Doze/App Standby throttling.
         Without this, the periodic heartbeat (Heartbeat.kt) gets deferred further
         and further the less often the app is opened — which is exactly the
         "away from home" case where an accurate position matters most. This is
         Google's documented justification for the permission: apps with a core
         function that depends on unrestricted background work. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Drive mode (DriveService.kt): while connected to the car's Bluetooth,
         a foreground service reports position every minute — the Home
         Assistant "high accuracy mode" pattern. The FGS pair is required on
         Android 14+ for a location-type foreground service; BLUETOOTH_CONNECT
         (runtime, 12+) is needed both to list bonded devices in the picker
         and to receive the ACL connect/disconnect broadcasts that start and
         stop the service. The legacy BLUETOOTH permission covers the same on
         Android 11 and below. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />

    <!-- Held only while drive mode is streaming, and only when journey
         recording is on (MotionSampler.kt). Play Services wakes the device to
         deliver a location fix, but nothing wakes it to deliver an accelerometer
         sample: once the AP suspends, a non-wakeup sensor stops reporting and
         every brake, corner and bump until the next fix is simply lost. A drive
         with the screen off would otherwise record where the car went and
         nothing about how it was driven. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Required to use PlaceListMapTemplate (car/FuelScreen.kt). The host
         refuses the template without it, so the fuel screen never renders and
         the app is dropped from the car — nothing appears on the phone. -->
    <uses-permission android:name="androidx.car.app.MAP_TEMPLATES" />

    <!-- Motion sensing is an enhancement, never a requirement: a phone with no
         gyroscope still reports roughness and event magnitudes from the
         accelerometer alone, and one with no accelerometer at all still records
         the journey. required=false on all three. -->
    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.barometer" android:required="false" />

    <!-- Geofencing is Play Services. Declared required so the Play Store (and a
         user reading the manifest) is honest about it. -->
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />

    <!-- The car app is an extra, never a requirement: this is a phone app that
         happens to also answer a head unit. required=true would hide it from
         every device without automotive hardware — i.e. all of them. -->
    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.ZmmPresence">

        <!-- Tells Android Auto this app speaks templates (res/xml/automotive_app_desc).
             Without it the CarAppService below is never discovered and the app
             simply does not appear in the car — no error, no log. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <meta-data
            android:name="androidx.car.app.minCarApiLevel"
            android:value="1" />

        <!-- Cheapest-fuel list on the head unit (car/FuelScreen.kt).
             exported=true is mandatory: the template host is a separate process
             and must bind this service. Who may bind is decided in code by the
             HostValidator, not here — a release build accepts only Google-signed
             hosts. Category POI is what the host uses to decide which templates
             this app is allowed, so it must match what the screen actually builds. -->
        <service
            android:name=".car.FuelCarAppService"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.POI" />
            </intent-filter>
        </service>

        <activity
            android:name=".PairActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- exported=false: only the OS geofencing service targets this, via the
             PendingIntent we hand it. Nothing else may spoof a transition. -->
        <receiver
            android:name=".GeofenceReceiver"
            android:exported="false" />

        <!-- Per-minute reporting while driving. exported=false: started only by
             CarBtReceiver and PairActivity. -->
        <service
            android:name=".DriveService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Passive fill (PassiveUpdates.kt): Play Services delivers batched
             location fixes here via our own PendingIntent. exported=false —
             the explicit PendingIntent reaches it regardless; nothing else
             may inject a fake position. -->
        <receiver
            android:name=".PassiveLocationReceiver"
            android:exported="false" />

        <!-- Wakes the app when the car's Bluetooth connects/disconnects.
             ACL_CONNECTED/DISCONNECTED are on Android's implicit-broadcast
             exemption list, so a manifest receiver gets them even with the app
             dead — this is what lets drive mode start without the app open.
             exported=true is required to receive them, and safe: both are
             protected broadcasts only the system can send. -->
        <receiver
            android:name=".CarBtReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
