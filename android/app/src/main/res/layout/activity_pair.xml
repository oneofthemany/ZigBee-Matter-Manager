<?xml version="1.0" encoding="utf-8"?>
<!--
    On the honeycomb: the backdrop is hexagonal, the controls are not. Cards
    stay rectangles for the same reason the dashboard's do (see frames.css) —
    a hex grid looks the part but cramps labels and buttons, and a screen you
    can't operate isn't worth the metaphor. The comb is texture; the hex chip
    and the ⬡ micro-labels carry the motif.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

<ScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- hero -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="2dp">

            <TextView
                android:layout_width="34dp"
                android:layout_height="39dp"
                android:background="@drawable/hex_chip"
                android:backgroundTint="@color/honey"
                android:gravity="center"
                android:text="@string/hex_mark"
                android:textColor="@color/honey_ink"
                android:fontFamily="monospace"
                android:textStyle="bold"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Zmm.Wordmark" />

                <TextView
                    android:id="@+id/versionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="monospace"
                    android:textSize="10sp"
                    android:letterSpacing="0.08"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/themeBtn"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:icon="@drawable/ic_theme_system"
                app:iconSize="21dp"
                app:iconTint="@color/accent"
                android:contentDescription="@string/theme_toggle" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp"
            android:text="@string/blurb"
            android:textAppearance="@style/TextAppearance.Zmm.Body" />

        <!-- hub -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_hub"
                        android:textAppearance="@style/TextAppearance.Zmm.MicroLabel" />

                    <TextView
                        android:id="@+id/hubPill"
                        style="@style/Widget.Zmm.Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:hint="@string/hub_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/hubUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:autofillHints="" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/discoverBtn"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="@string/discover" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/user_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/userId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:autofillHints="" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/token_hint"
                    app:passwordToggleEnabled="true">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/token"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:autofillHints="" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/pairBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/pair" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Permissions before geofence, because Arm is disabled until location
             is granted (render(): isPaired && hasHome && fg && bg). With the
             grant buttons below the button they unlock, the only way to arm was
             to scroll past a dead control, grant, then scroll back up to it.
             Cards now run in dependency order: hub, then what the geofence
             needs, then the geofence. -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_permissions"
                        android:textAppearance="@style/TextAppearance.Zmm.MicroLabel" />

                    <TextView
                        android:id="@+id/permPill"
                        style="@style/Widget.Zmm.Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/permState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="@style/TextAppearance.Zmm.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/permsBtn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/grant_location" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/border_color" />

                <!-- Background-throttling exemption. See battery_body for why
                     this is not optional polish: without it, reports silently
                     degrade to once every few hours the less often the app is
                     opened. -->
                <TextView
                    android:id="@+id/batteryState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Zmm.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/batteryBtn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/battery_btn" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- geofence -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_geofence"
                        android:textAppearance="@style/TextAppearance.Zmm.MicroLabel" />

                    <TextView
                        android:id="@+id/geoPill"
                        style="@style/Widget.Zmm.Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/homeState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="@style/TextAppearance.Zmm.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/armBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/arm" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- drive mode -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_drive"
                        android:textAppearance="@style/TextAppearance.Zmm.MicroLabel" />

                    <TextView
                        android:id="@+id/drivePill"
                        style="@style/Widget.Zmm.Pill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <TextView
                    android:id="@+id/carState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textAppearance="@style/TextAppearance.Zmm.Body" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/carBtn"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/car_btn" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- this device -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_device"
                    android:textAppearance="@style/TextAppearance.Zmm.MicroLabel" />

                <TextView
                    android:id="@+id/deviceId"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:lineSpacingMultiplier="1.2"
                    android:textIsSelectable="true" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/forgetBtn"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/status_bad"
                    android:text="@string/forget" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>

    <!-- Status line. Reports on whatever action just ran rather than on any one
         section, so it sits outside the cards — and outside the ScrollView,
         pinned. Buttons are spread down a screen taller than the viewport, so
         inside the scroll it landed off-screen: pressing Pair at the top wrote
         its answer below the fold, which is what made the screen feel like it
         needed reading twice. Hidden entirely until there is something to say
         (see status()), so it costs no height on a fresh install. -->
    <View
        android:id="@+id/statusDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:visibility="gone"
        android:background="@color/border_color" />

    <TextView
        android:id="@+id/status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:background="@color/bg_surface_raised"
        android:padding="14dp"
        android:fontFamily="monospace"
        android:textSize="11sp"
        android:lineSpacingMultiplier="1.2"
        android:textColor="@color/text_secondary" />
</LinearLayout>
