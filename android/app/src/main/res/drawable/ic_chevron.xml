<?xml version="1.0" encoding="utf-8"?>
<!--
    Collapsed state points down, expanded points up. One drawable, rotated
    180° in code rather than two assets — the rotation animates, a swap
    doesn't, and the affordance reads better when it turns.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="20dp"
    android:height="20dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@color/text_muted">
    <path
        android:fillColor="#ffffff"
        android:pathData="M7.4,8.6 L12,13.2 L16.6,8.6 L18,10 L12,16 L6,10 Z" />
</vector>
