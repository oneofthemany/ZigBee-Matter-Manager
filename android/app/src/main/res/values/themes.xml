<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        NoActionBar: the hero strip in activity_pair.xml is the title now.
        Keeping the system ActionBar as well would show the app name twice and
        put an opaque band across the honeycomb backdrop.
    -->
    <style name="Theme.ZmmPresence" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/honey_ink</item>
        <item name="colorPrimaryContainer">@color/honey_soft</item>
        <item name="colorOnPrimaryContainer">@color/honey_ink</item>

        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/honey_ink</item>

        <item name="colorError">@color/status_bad</item>

        <!--
            The backdrop is painted by HoneycombDrawable, so the window itself
            is transparent. A colour here would cover the comb during
            activity transitions.
        -->
        <item name="android:colorBackground">@color/bg_body</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorSurfaceVariant">@color/bg_surface_raised</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border_color</item>
        <item name="colorOutlineVariant">@color/border_color</item>

        <!-- Edge-to-edge is forced at targetSdk 35; let the comb run under the
             system bars rather than fighting it with an opaque strip. -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>

        <item name="materialButtonStyle">@style/Widget.Zmm.Button</item>
        <item name="materialCardViewStyle">@style/Widget.Zmm.Card</item>
    </style>

    <!--
        Filled buttons stay raw honey with dark ink in BOTH themes, which is
        what the dashboard does by pairing its honey fill with honey-ink text.
        colorPrimary
        cannot carry this: it doubles as the colour of outlined-button text and
        links, where light mode needs the darkened accent for contrast. One
        token, two jobs — so the fill is pinned here instead.
    -->
    <style name="Widget.Zmm.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/honey</item>
        <item name="android:textColor">@color/honey_ink</item>
        <item name="iconTint">@color/honey_ink</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Zmm.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/bg_surface</item>
        <item name="strokeColor">@color/border_color</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
    </style>

    <!--
        Card micro-label: mono, uppercase, wide tracking, honey. Lifted from
        `.card-header .fw-bold` in hive-components.css, hex glyph included —
        it is the manager's strongest recurring motif and the cheapest way for
        the phone to read as the same product.
    -->
    <style name="TextAppearance.Zmm.MicroLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.16</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="TextAppearance.Zmm.Wordmark" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0.10</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <!-- Status pill. Background tint and text colour are set per-state in
         PairActivity; only the shape and metrics live here. -->
    <!-- parent="" is required, not stylistic: a dotted style name implies a
         parent of everything before the last dot, and Widget.Zmm does not
         exist. -->
    <style name="Widget.Zmm.Pill" parent="">
        <item name="android:background">@drawable/pill</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingBottom">3dp</item>
    </style>

    <style name="TextAppearance.Zmm.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

</resources>
