# Copy to config/secrets.yaml and fill in. That path is gitignored; this
# example is not, and must never carry a real value.
#
# The environment takes precedence over this file, so a container can supply
# ZMM_FUEL_FINDER_CLIENT_ID / ZMM_FUEL_FINDER_CLIENT_SECRET instead and leave
# the file absent entirely.
#
# Credentials come from the Fuel Finder developer portal:
#   https://www.developer.fuel-finder.service.gov.uk  (GOV.UK One Login)
# Create an application under "Information Recipients" to get a client
# id/secret pair for the production environment.

fuel_finder:
  client_id: ""
  client_secret: ""
