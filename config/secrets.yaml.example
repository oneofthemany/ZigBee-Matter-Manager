# Copy to config/secrets.yaml and fill in. That path is gitignored; this
# example is not, and must never carry a real value.
#
# The environment takes precedence over this file, so a container can supply
# ZMM_FUEL_FINDER_CLIENT_ID / ZMM_FUEL_FINDER_CLIENT_SECRET instead and leave
# the file absent entirely.
#
# Credentials come from the Fuel Finder developer portal:
#   https://www.developer.fuel-finder.service.gov.uk  (GOV.UK One Login)
# Create an application under "Information Recipients" to get a client
# id/secret pair for the production environment.

fuel_finder:
  client_id: ""
  client_secret: ""

# Germany only. A free key from https://creativecommons.tankerkoenig.de/
# (onboarding.tankerkoenig.de issues it). The environment variable
# ZMM_TANKERKOENIG_API_KEY takes precedence over this file.
#
# The data is CC BY 4.0: the attribution the Drive tab shows is a licence
# condition, not decoration. Mineral oil companies and station operators are
# not permitted to use the service at all.
tankerkoenig:
  api_key: ""

# Queensland only. A subscriber token from https://www.fuelpricesqld.com.au/
# (apply, accept the terms, and they email the token). The environment variable
# ZMM_FUELPRICES_QLD_TOKEN takes precedence over this file.
#
# NSW/ACT (FuelCheck) and WA (FuelWatch) need no credentials at all.
fuelprices_qld:
  token: ""

# United States only. A free key from https://www.eia.gov/opendata/register.php
# The environment variable ZMM_EIA_API_KEY takes precedence over this file.
#
# Note what this buys: EIA publishes weekly *averages* by state and region.
# There is no station-level price feed for the US, so the Drive tab shows an
# average rather than the cheapest station near you.
eia:
  api_key: ""
